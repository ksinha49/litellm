# .env.deploy.example — Copy to .env.deploy and fill in your secrets.
# .env.deploy is gitignored and should NEVER be committed.
#
# All values here are the same defaults shown at the interactive prompts.
# Leave a value blank to be prompted at runtime.
#
# Usage:
#   cp .env.deploy.example .env.deploy
#   # edit .env.deploy with real credentials
#   ./deploy.sh

# ── Container / Image ──────────────────────────────────────────────────────────
IMAGE_TAG=litellm-local
LITELLM_CONTAINER=litellm
PROMETHEUS_CONTAINER=litellm-prometheus-1
DOCKER_NETWORK=litellm-net
HOST_PORT=8080
PROMETHEUS_PORT=9090

# ── Application ────────────────────────────────────────────────────────────────
APP_NAME=Ameritas LiteLLM
PROXY_BASE_URL=https://api.ai.inbison.com
# CONFIG_PATH defaults to <repo-root>/litellm_config.yaml — override if needed
# CONFIG_PATH=/opt/liteLLM/litellm/litellm_config.yaml
# PROMETHEUS_CONFIG defaults to <repo-root>/prometheus.yml — override if needed
# PROMETHEUS_CONFIG=/opt/liteLLM/litellm/prometheus.yml

# ── Corporate proxy ────────────────────────────────────────────────────────────
HTTP_PROXY_URL=http://proxy.ameritas.com:8080
NO_PROXY_LIST=localhost,127.0.0.1,registry-1.docker.io

# ── Database ───────────────────────────────────────────────────────────────────
DB_HOST=aio-llm-litellm-db2.cfko4wc6k724.us-east-2.rds.amazonaws.com
DB_PORT=5432
DB_NAME=litellmdb
DB_SCHEMA=litellm
DB_USER=ameritasadmin
DB_PASSWORD=          # <-- fill in

# ── LiteLLM secrets ────────────────────────────────────────────────────────────
LITELLM_MASTER_KEY=   # <-- fill in
LITELLM_SALT_KEY=     # <-- fill in
